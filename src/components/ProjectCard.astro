---
import type { CollectionEntry } from 'astro:content';
import { url } from '../site';

interface Props { project: CollectionEntry<'work'> }
const { project } = Astro.props;
const { title, summary, company, year, cover, accent } = project.data;
---

<a class="card" href={url(`/work/${project.id}`)}>
  <div class="media" style={`--card-accent: ${accent}`}>
    {cover ? <img src={url(cover)} alt="" loading="lazy" /> : <span class="placeholder serif">{title}</span>}
  </div>
  <div class="meta">
    <h3>{title}</h3>
    <p class="muted">{summary}</p>
    <p class="muted small">{company} · {year}</p>
  </div>
</a>

<style>
  .card { display: block; text-decoration: none; color: inherit; }
  .media {
    aspect-ratio: 4 / 3; border-radius: var(--radius); overflow: hidden;
    background: var(--card-accent); display: grid; place-items: center;
  }
  .media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .placeholder { font-size: clamp(1.5rem, 3vw, 2.25rem); color: #1a1a18; opacity: 0.7; padding: 24px; text-align: center; }
  .meta { padding-top: 16px; }
  h3 { margin: 0 0 4px; font-size: 1.15rem; }
  p { margin: 0; }
  .small { font-size: 0.875rem; margin-top: 8px; }
  @media (prefers-reduced-motion: no-preference) {
    .card:hover .media img { transform: scale(1.03); }
  }
  .card:hover h3 { color: var(--accent); }
</style>
