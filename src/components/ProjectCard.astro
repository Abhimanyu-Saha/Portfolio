---
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import { url } from '../site';

interface Props {
  project: CollectionEntry<'work'>;
  /** Cards visible on first load shouldn't wait for lazy-loading. */
  eager?: boolean;
}
const { project, eager = false } = Astro.props;
const { title, summary, company, year, cover, coverAlt, accent } = project.data;
---

<a class="card" href={url(`/work/${project.id}`)}>
  <div class="media" style={`--card-accent: ${accent}`}>
    {cover ? (
      <Picture
        src={cover}
        alt={coverAlt}
        formats={['avif', 'webp']}
        width={1120}
        height={840}
        widths={[400, 560, 800, 1120]}
        sizes="(max-width: 720px) calc(100vw - 48px), 536px"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
      />
    ) : (
      <span class="placeholder serif">{title}</span>
    )}
  </div>
  <div class="meta">
    <h3>{title}</h3>
    <p class="muted">{summary}</p>
    <p class="muted small">{company} · {year}</p>
  </div>
</a>

<style>
  .card { display: block; text-decoration: none; color: inherit; }
  .media {
    aspect-ratio: 4 / 3; border-radius: var(--radius); overflow: hidden;
    background: var(--card-accent); display: grid; place-items: center;
  }
  .media :global(picture), .media :global(img) { width: 100%; height: 100%; }
  .media :global(img) { object-fit: cover; transition: transform 0.5s ease; }
  .placeholder { font-size: clamp(1.5rem, 3vw, 2.25rem); color: #1a1a18; opacity: 0.7; padding: 24px; text-align: center; }
  @media (prefers-color-scheme: dark) {
    .media { background: color-mix(in oklab, var(--card-accent) 14%, var(--surface)); }
    .placeholder { color: var(--text); }
  }
  .meta { padding-top: 16px; }
  h3 { margin: 0 0 4px; font-size: 1.15rem; }
  p { margin: 0; }
  .small { font-size: 0.875rem; margin-top: 8px; }
  @media (prefers-reduced-motion: no-preference) {
    .card:hover .media :global(img) { transform: scale(1.03); }
  }
  .card:hover h3 { color: var(--accent); }
</style>
