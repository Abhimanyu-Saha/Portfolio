---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';

const shipped = [
  {
    stat: '29%',
    label: 'more merchants adopted',
    title: 'WhatsApp Commerce Suite',
    body: 'Lets brands run marketing campaigns, automate support and sell inside WhatsApp chats.',
  },
  {
    stat: '100+',
    label: 'components, 20% faster handoff',
    title: 'Lime Design System',
    body: 'Built from scratch and still maintained by me. One visual language across 5+ product surfaces.',
  },
  {
    stat: 'LLM',
    label: 'agent UX patterns',
    title: 'AI agent conversations',
    body: "Conversation flows, fallbacks and human-handoff experiences for LimeChat's GPT-powered chatbot.",
  },
];

const experience = [
  { role: 'Senior Product Designer', org: 'LimeChat', place: 'Bengaluru', years: '2026 — Now' },
  { role: 'Product Designer', org: 'LimeChat', place: 'Bengaluru', years: '2022 — 2026' },
  { role: 'Junior Architect', org: 'Prakalpa Space Kraft', place: 'Kolkata', years: '2019 — 2020' },
  { role: 'Intern Architect', org: 'Public Works Department, West Bengal', place: 'Kolkata', years: '2018 — 2019' },
  { role: '3D Visualiser & Graphic Designer', org: 'Freelance', place: 'Kolkata', years: '2015 — 2022' },
];

const education = [
  { role: "Master's in Information Design", org: 'National Institute of Design', years: '2020 — 2023' },
  { role: 'Bachelor of Architecture', org: 'NIT Raipur', years: '2014 — 2019' },
];

const recognition = [
  'Best Thesis Award',
  "D'source SDG Challenge — Winner",
  'Information is Beautiful Awards — Longlist',
];

const focus = [
  { label: 'Design systems', tone: 'green' },
  { label: 'LLM & agent UX', tone: 'blue' },
  { label: 'User research', tone: 'yellow' },
  { label: 'B2B SaaS', tone: 'red' },
];
const toolkit = ['Figma', 'FigJam', 'Maze', 'Hotjar', 'Notion', 'Linear'];
---

<Base
  title="About"
  description={`${SITE.name} is a ${SITE.role} at ${SITE.company}, designing AI-powered commerce tools for 400+ D2C brands.`}
>
  <div class="about minimal">
    <header class="intro" data-reveal>
      <p class="meta">{SITE.role} · {SITE.company} · {SITE.location}</p>
      <h1 class="serif">
        I design AI-powered commerce tools that help 400+ brands sell, support and grow on WhatsApp.
      </h1>
    </header>

    <section class="cols" aria-label="Story">
      <div class="story" data-reveal>
        <p class="lead">My path into product design wasn't a straight line: architecture, then information design, then software.</p>
        <p>
          Architecture at NIT Raipur taught me to think in systems: how parts depend on each other, and
          how people actually move through a space. Information Design at the National Institute of
          Design (where I entered with All-India Rank 1) taught me to make complex things legible.
        </p>
        <p>
          At {SITE.company} I lead product design for one of India's fastest-growing conversational AI
          platforms. I work end to end on B2B SaaS: research, flows, interface, design system, and the
          new problems of designing for LLMs, from conversation design and prompt UX to handing a chat
          from an AI agent to a human.
        </p>
        <p>
          Outside work I'm exploring how AI is changing design, both as a tool and as a material,
          through side projects like <em>8 Frames</em> and experiments with generative interfaces.
        </p>
      </div>

      <aside class="facts" data-reveal>
        <h2 class="meta">Focus</h2>
        <ul class="tags">
          {focus.map((f) => <li class={`tag ${f.tone}`}>{f.label}</li>)}
        </ul>
        <h2 class="meta">Toolkit</h2>
        <ul class="tools">
          {toolkit.map((t) => <li>{t}</li>)}
        </ul>
      </aside>
    </section>

    <section aria-labelledby="shipped">
      <h2 id="shipped" class="meta heading" data-reveal>Selected impact at {SITE.company}</h2>
      <ul class="bento">
        {shipped.map((s, i) => (
          <li class="card" data-reveal style={`--i: ${i}`}>
            <p class="stat serif">{s.stat}</p>
            <p class="label">{s.label}</p>
            <h3>{s.title}</h3>
            <p class="muted">{s.body}</p>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="experience">
      <h2 id="experience" class="meta heading" data-reveal>Experience</h2>
      <ul class="rows">
        {experience.map((e, i) => (
          <li data-reveal style={`--i: ${i}`}>
            <span><strong>{e.role}</strong> <span class="muted">{e.org}</span></span>
            <span class="mono">{e.years}</span>
          </li>
        ))}
      </ul>
    </section>

    <div class="pair">
      <section aria-labelledby="education">
        <h2 id="education" class="meta heading" data-reveal>Education</h2>
        <ul class="rows">
          {education.map((e, i) => (
            <li data-reveal style={`--i: ${i}`}>
              <span><strong>{e.role}</strong><br /><span class="muted">{e.org}</span></span>
              <span class="mono">{e.years}</span>
            </li>
          ))}
        </ul>
      </section>
      <section aria-labelledby="recognition">
        <h2 id="recognition" class="meta heading" data-reveal>Recognition</h2>
        <ul class="rows">
          {recognition.map((r, i) => <li data-reveal style={`--i: ${i}`}><span>{r}</span></li>)}
        </ul>
      </section>
    </div>

    <section class="contact" data-reveal aria-label="Contact">
      <p class="serif">Always happy to talk about AI, design systems or hard B2B problems.</p>
      <a class="btn" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </section>
  </div>
</Base>

<script>
  import '../scripts/reveal';
</script>

<style>
  .about {
    max-width: 960px; margin: 0 auto; padding: 72px 24px 0;
    display: grid; gap: 128px;
  }

  .muted { color: var(--sub); }
  .mono, .label { font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.02em; color: var(--sub); }
  .heading { padding-bottom: 16px; border-bottom: 1px solid var(--rule); margin-bottom: 0; }

  /* Intro: one soft warm light spot, no hard backgrounds */
  .intro { position: relative; }
  .intro::before {
    content: ''; position: absolute; inset: -120px -20% -80px; z-index: -1; pointer-events: none;
    background: radial-gradient(40% 60% at 20% 40%, rgb(210 170 120 / 0.08), transparent 70%);
  }
  h1 {
    margin: 0; max-width: 22ch;
    font-size: clamp(2.25rem, 5vw, 3.75rem); line-height: 1.1; letter-spacing: -0.03em;
  }

  .cols { display: grid; grid-template-columns: minmax(0, 1fr) 240px; gap: 80px; align-items: start; }
  .story p { margin: 0 0 1.25rem; line-height: 1.7; max-width: 62ch; }
  .lead { font-size: 1.3rem; line-height: 1.5 !important; letter-spacing: -0.01em; }
  .facts { position: sticky; top: 32px; }
  .facts .meta { margin-bottom: 14px; }
  .tags, .tools { list-style: none; margin: 0 0 40px; padding: 0; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .tag {
    font-size: 0.7rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em;
    padding: 4px 10px; border-radius: 9999px;
  }
  .green { background: #edf3ec; color: #346538; }
  .blue { background: #e1f3fe; color: #1f6c9f; }
  .yellow { background: #fbf3db; color: #956400; }
  .red { background: #fdebec; color: #9f2f2d; }
  @media (prefers-color-scheme: dark) {
    .green { background: rgb(52 101 56 / 0.25); color: #a9cfac; }
    .blue { background: rgb(31 108 159 / 0.25); color: #9fcdec; }
    .yellow { background: rgb(149 100 0 / 0.25); color: #e3c37a; }
    .red { background: rgb(159 47 45 / 0.25); color: #eba9a7; }
  }
  .tools li { padding: 8px 0; border-bottom: 1px solid var(--rule); font-size: 0.95rem; }

  /* Bento: first card spans two rows on the left; two cards stack on the right. No empty cells. */
  .bento {
    list-style: none; margin: 32px 0 0; padding: 0;
    display: grid; grid-template-columns: 1.2fr 1fr; grid-auto-flow: dense; gap: 16px;
  }
  .card {
    border: 1px solid var(--rule); border-radius: 12px; background: var(--card);
    padding: 32px; display: flex; flex-direction: column;
    transition: box-shadow 0.2s ease;
  }
  .card:hover { box-shadow: 0 2px 8px rgb(0 0 0 / 0.04); }
  .card:first-child { grid-row: span 2; justify-content: space-between; background: var(--canvas); }
  .card p { margin: 0; }
  .stat { font-size: 3.5rem; line-height: 1; letter-spacing: -0.03em; }
  .card:first-child .stat { font-size: clamp(4.5rem, 9vw, 7rem); }
  .label { margin-top: 10px !important; }
  .card h3 { margin: 32px 0 6px; font-size: 1.05rem; font-weight: 500; }
  .card:first-child h3 { margin-top: auto; padding-top: 48px; }

  .rows { list-style: none; margin: 0; padding: 0; }
  .rows li {
    display: flex; justify-content: space-between; align-items: baseline; gap: 24px;
    padding: 20px 0; border-bottom: 1px solid var(--rule);
  }
  .rows .mono { white-space: nowrap; }
  strong { font-weight: 500; margin-right: 6px; }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; }

  .contact { border-top: 1px solid var(--rule); padding-top: 64px; }
  .contact p { font-size: clamp(1.75rem, 3.5vw, 2.5rem); line-height: 1.15; letter-spacing: -0.02em; margin: 0 0 32px; max-width: 24ch; }
  @media (max-width: 860px) {
    .about { gap: 96px; padding-top: 48px; }
    .cols, .pair { grid-template-columns: 1fr; gap: 56px; }
    .facts { position: static; }
    .bento { grid-template-columns: 1fr; }
    .card:first-child { grid-row: auto; }
    .card { padding: 24px; }
  }
  @media (max-width: 480px) {
    .rows li { flex-direction: column; gap: 4px; }
  }
</style>
