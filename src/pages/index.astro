---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE } from '../site';
import { getWork } from '../lib';

const work = await getWork();
---

<Base>
  <section class="hero container">
    <p class="muted">{SITE.role}</p>
    <h1 class="serif">{SITE.tagline}</h1>
  </section>

  <section id="work" class="container" aria-labelledby="work-heading">
    <h2 id="work-heading" class="label muted">Selected work</h2>
    <div class="grid">
      {work.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: 96px; padding-bottom: 120px; }
  .hero p { margin: 0 0 16px; }
  .hero h1 { font-size: clamp(2.5rem, 7vw, 5rem); line-height: 1.02; margin: 0; max-width: 16ch; }
  .label { font-size: 0.875rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 24px; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 56px 32px; }
  @media (max-width: 720px) {
    .hero { padding-top: 48px; padding-bottom: 72px; }
    .grid { grid-template-columns: 1fr; gap: 40px; }
  }
</style>
