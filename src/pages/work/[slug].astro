---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getWork } from '../../lib';
import { url } from '../../site';

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: work[(i + 1) % work.length] },
  }));
}

const { project, next } = Astro.props;
const { title, summary, company, role, year, tags, cover, accent } = project.data;
const { Content } = await render(project);
---

<Base title={title} description={summary} image={cover ? url(cover) : undefined}>
  <article>
    <header class="container intro">
      <a class="back muted" href={url('/#work')}>← All work</a>
      <h1 class="serif">{title}</h1>
      <p class="summary">{summary}</p>
      <dl class="facts">
        <div><dt class="muted">Company</dt><dd>{company}</dd></div>
        <div><dt class="muted">Role</dt><dd>{role}</dd></div>
        <div><dt class="muted">Year</dt><dd>{year}</dd></div>
        {tags.length > 0 && <div><dt class="muted">Scope</dt><dd>{tags.join(', ')}</dd></div>}
      </dl>
    </header>

    <div class="container">
      <div class="cover" style={`background: ${accent}`}>
        {cover && <img src={url(cover)} alt="" />}
      </div>
    </div>

    <div class="container body">
      <div class="prose"><Content /></div>
    </div>
  </article>

  {next && next.id !== project.id && (
    <nav class="container next" aria-label="Next case study">
      <span class="muted">Next</span>
      <a class="serif" href={url(`/work/${next.id}`)}>{next.data.title} →</a>
    </nav>
  )}
</Base>

<style>
  .intro { padding-top: 48px; padding-bottom: 56px; }
  .back { text-decoration: none; font-size: 0.9rem; }
  h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); line-height: 1.05; margin: 24px 0 16px; max-width: 18ch; }
  .summary { font-size: 1.25rem; max-width: 40ch; margin: 0 0 40px; }
  .facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; margin: 0; border-top: 1px solid var(--line); padding-top: 24px; }
  dt { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 4px; }
  dd { margin: 0; }
  .cover { border-radius: var(--radius); overflow: hidden; aspect-ratio: 16 / 9; }
  .cover img { width: 100%; height: 100%; object-fit: cover; }
  .body { padding-top: 64px; }
  .next { margin-top: 96px; display: grid; gap: 8px; }
  .next a { font-size: clamp(1.75rem, 4vw, 2.75rem); text-decoration: none; }
  @media (max-width: 720px) { .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
